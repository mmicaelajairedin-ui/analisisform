{
  "appId": "com.pathwaycareercoach.twa",
  "appName": "Pathway",
  "webDir": "www",
  "server": {
    "url": "https://pathwaycareercoach.com/login.html?app=1",
    "cleartext": false,
    "allowNavigation": [
      "pathwaycareercoach.com",
      "*.pathwaycareercoach.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#FAFDF9",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FAFDF9",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
