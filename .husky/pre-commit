#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Validando Supabase URLs y configuración..."
node scripts/validate-supabase-config.js
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: Errores de configuración detectados"
  echo "   Ejecuta 'npm run verify' para ver todos los problemas"
  exit 1
fi

echo "✅ Validación OK. Commit permitido."
exit 0
