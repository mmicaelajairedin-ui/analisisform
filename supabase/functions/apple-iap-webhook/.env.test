# Test environment variables for apple-iap-webhook security tests
# Use with: supabase functions serve --env-file supabase/functions/apple-iap-webhook/.env.test

# Allow unsigned test notifications (ONLY for local testing, NEVER in production)
IAP_ALLOW_UNSIGNED_TEST=true

# Test environment (must match test payloads: 'Sandbox')
IAP_ENVIRONMENT=Sandbox

# Test Supabase URL (localhost — indicates local/test environment)
SUPABASE_URL=http://localhost:54321

# Note: SUPABASE_SERVICE_ROLE_KEY is provided by supabase functions serve locally
# and should NOT be hardcoded in this file (security risk)
