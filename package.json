{
  "name": "analisisform-testing-agent",
  "version": "1.0.0",
  "description": "Agente de testing diario para la plataforma de mentoría de Micaela Jairedin",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:report": "node tests/generate-report.js",
    "test:daily": "npx playwright test --reporter=json 2>/dev/null | node tests/generate-report.js",
    "verify": "node scripts/verify.js",
    "test:mc-permisos": "node --experimental-strip-types scripts/probar-editar-coach-red-mc-permisos.mjs",
    "triage": "node scripts/error-triage.js",
    "test:sonnet-5-5": "REF_ORIGINAL=b39f024 node --experimental-strip-types --no-warnings scripts/probar-migracion-sonnet-5-5.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "husky": "^9.1.7",
    "pdfkit": "^0.19.1"
  },
  "dependencies": {
    "@capgo/native-purchases": "6.0.42",
    "@supabase/supabase-js": "^2.112.1",
    "playwright": "^1.62.1"
  }
}
