# Cloudflare Pages headers config
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Estrategia:
# - HTML: max-age=0, must-revalidate → cambios se ven al instante
# - Assets en /assets/ y fonts: cache largo (1 año immutable) → carpetas
#   versionadas o estáticas que casi no cambian
# - CSS/JS/imágenes en raíz: cache 1 mes (sin immutable, por si se renuevan)
# - JSON/XML: 1 día
#
# El problema histórico (cachePct ~4.9%) era que solo HTML tenía rules,
# entonces el resto pasaba por max-age default de Cloudflare (corto) y
# Cache-Control de GitHub Pages (cero o muy bajo).

# HTML — siempre revalidar para que cambios se vean inmediato
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Carpeta /assets/ — cache 1 año immutable (típica para imágenes versionadas)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — cache 1 año immutable (casi nunca cambian)
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.otf
  Cache-Control: public, max-age=31536000, immutable
/*.eot
  Cache-Control: public, max-age=31536000, immutable

# CSS — siempre revalidar (la app cambia seguido y los <link> no tienen cache-bust)
/*.css
  Cache-Control: public, max-age=0, must-revalidate

# JS — siempre revalidar (la app cambia seguido y los <script src> no tienen cache-bust)
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Imágenes — cache 1 mes
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.gif
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/*.avif
  Cache-Control: public, max-age=2592000

# Videos
/*.mp4
  Cache-Control: public, max-age=2592000
/*.webm
  Cache-Control: public, max-age=2592000

# JSON/XML (sitemap, manifest, robots, etc) — 1 día.
# IMPORTANTE: fijamos el Content-Type explícito. Con `nosniff` (más abajo, en
# /*), Google NO adivina el tipo — usa el que le mandamos. Si no es EXACTAMENTE
# el correcto, Search Console reporta "El sitemap es HTML" y descubre 0 páginas.
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8
/manifest.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8
/favicon.svg
  Cache-Control: public, max-age=86400
  Content-Type: image/svg+xml

# Branding JSON — JaaS/Jitsi lo lee desde el navegador (dynamic branding) y
# otros partners/integraciones lo consumen cross-origin. Necesitan CORS abierto
# y el Content-Type correcto. Cache corto para poder ajustar la marca sin esperar.
/jaas-branding.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
/branding.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Security headers (bonus — no afecta cache pero ya que estamos)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=*, camera=*
